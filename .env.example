# ==============================================================================
# Smart LPG Leak Detection & Automatic Shut-Off System Configuration
# Academic Simulation Prototype
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database
DATABASE_PATH=data/lpg_safety.db

# Demonstration Safety Thresholds (in PPM - Parts Per Million)
# NOTE: These are academic demonstration thresholds and NOT certified real-world limits.
GAS_SAFE_MAX=199.0
GAS_WARNING_THRESHOLD=200.0
GAS_DANGER_THRESHOLD=400.0
GAS_CRITICAL_THRESHOLD=700.0

# Hysteresis Band (PPM) to prevent valve chattering near thresholds
GAS_HYSTERESIS_PPM=30.0

# Rate-of-Rise (RoR) Thresholds
# Threshold in PPM per second to classify abnormal rapid rise
RATE_OF_RISE_THRESHOLD=25.0

# Sensor Smoothing Parameters
# EMA smoothing factor: 0.0 < alpha <= 1.0 (lower = smoother, higher = more responsive)
EMA_ALPHA=0.25
MOVING_AVERAGE_WINDOW=5

# Sensor Health & Plausibility Limits
SENSOR_MIN_PPM=0.0
SENSOR_MAX_PPM=2500.0
SENSOR_MAX_JUMP_PER_SEC=350.0
SENSOR_STUCK_READING_COUNT=8
SENSOR_TIMEOUT_SECONDS=5.0

# Simulation Configuration
SIMULATION_INTERVAL_SEC=1.0
DEFAULT_SCENARIO=NORMAL

# MQTT Telemetry (Optional Integration)
MQTT_ENABLED=False
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=lpg_system/telemetry
MQTT_ALERTS_TOPIC=lpg_system/alerts

# Machine Learning Anomaly Detection
ML_ANOMALY_ENABLED=True
ML_CONTAMINATION_RATE=0.05
